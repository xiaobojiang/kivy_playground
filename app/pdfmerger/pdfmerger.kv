#:kivy 1.1.0

Root:
    text_input: text_input

    BoxLayout:
        orientation: 'vertical'
        BoxLayout:
            TextInput:
                id: text_input
                text: ''
                readonly: True

        BoxLayout:
            size_hint_y: None
            height: dp(30)
            Button:
                text: 'Load'
                on_release: root.show_load()
            Button:
                text: 'Merge'
                on_release: root.show_save()

        

<LoadDialog>:
    BoxLayout:
        size: root.size
        pos: root.pos
        orientation: "vertical"
        Label:
            size_hint_y: None
            height: dp(28)
            text: 'Left-click PDFs one by one to select multiple files. No Shift or Cmd needed.'

        FileChooserListView:
            id: filechooser
            multiselect: True
            filters: ['*.pdf']
            rootpath: root.homepath

        Label:
            size_hint_y: None
            height: dp(24)
            text: 'Selected: {} file(s)'.format(len(filechooser.selection))

        BoxLayout:
            size_hint_y: None
            height: dp(30)
            Button:
                text: "Add All PDFs"
                on_release: root.load_all(filechooser.path)
            Button:
                text: "Remove Selected"
                on_release: root.remove(filechooser.path, filechooser.selection)
            Button:
                text: "Clear Loaded List"
                on_release: root.clear()
            Button:
                text: "Cancel"
                on_release: root.cancel()

            Button:
                text: "Load"
                on_release: root.load(filechooser.path, filechooser.selection)

<SaveDialog>:
    text_input: text_input
    BoxLayout:
        size: root.size
        pos: root.pos
        orientation: "vertical"
        FileChooserIconView:
            id: filechooser
            filters: ['*.pdf']
            rootpath: root.homepath

        TextInput:
            id: text_input
            size_hint_y: None
            height: dp(30)
            multiline: False
            hint_text: 'Output file name (e.g. merged.pdf)'
            text: 'merged.pdf'

        BoxLayout:
            size_hint_y: None
            height: dp(30)
            Button:
                text: "Use selected file name"
                on_release: root.use_selected_name(filechooser.selection)

        BoxLayout:
            size_hint_y: None
            height: dp(30)
            Button:
                text: "Cancel"
                on_release: root.cancel()

            Button:
                text: "Save"
                on_release: root.save(filechooser.path, text_input.text)